{
  "is_demo_data": true,
  "data_path": "data/demo_area_data.csv",
  "target": "area_ha",
  "units": "hectares",
  "unit_symbol": "ha",
  "random_seed": 42,
  "date_column": "event_date",
  "group_column": "event_id",
  "split_strategy": "time",
  "split_fractions": [0.70, 0.15, 0.15],
  "raw_numeric_features": ["latitude", "longitude", "elevation_m", "rainfall_mm", "temperature_c", "population_density", "prior_area_ha"],
  "categorical_features": ["region", "land_cover"],
  "required_fields": ["latitude", "longitude", "event_date", "region", "land_cover"],
  "leakage_columns": ["burned_fraction_post"],
  "valid_ranges": {
    "latitude": [-90, 90], "longitude": [-180, 180], "elevation_m": [-500, 9000],
    "rainfall_mm": [0, 5000], "temperature_c": [-60, 60],
    "population_density": [0, 50000], "prior_area_ha": [0, 10000000]
  },
  "model_path": "models/area_model.joblib",
  "output_dir": "outputs"
}
